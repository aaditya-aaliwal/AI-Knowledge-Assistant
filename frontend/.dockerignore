# Host dependencies are platform-specific and must never enter the image.
node_modules
.pnpm-store

# Build output and local tooling state are generated inside the container.
dist
.vite
*.tsbuildinfo

# Do not bake local configuration or repository metadata into the image.
.env
.env.*
!.env.example
.git
.gitignore
Dockerfile
docker-compose*.yml
npm-debug.log*
pnpm-debug.log*
